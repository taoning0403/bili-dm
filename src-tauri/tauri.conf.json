{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bili DM",
  "version": "../package.json",
  "identifier": "dev.bilidm.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bili DM · 本地播放器",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#00000000",
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "本地优先的桌面媒体播放器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "lib/": "lib/",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/": "licenses/"
    }
  }
}
